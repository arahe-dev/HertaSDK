runtime main { resource db capacity 1 }
op main::a() -> u64 { effect pure calls b retry max 2 on { uncertain } classify { _ => permanent } }
handler main::a() -> (u64, error) { return 0, nil }
op main::b() -> u64 { effect nonidempotent retry max 2 on { transient } classify { ErrA => transient, _ => permanent } }
handler main::b() -> (u64, error) { return 0, nil }
