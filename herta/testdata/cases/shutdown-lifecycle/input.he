// Shutdown rejects new work, drains active calls, wakes queued waiters with
// ErrRuntimeStopping; an idle shutdown beats an expired context; when
// Shutdown returns nil, Finished == Admitted (Δ2).
runtime main {
    resource db_write capacity 3
}

op main::work(n: int) -> int {
    effect pure
    admission wait
    resources { db_write units 1 }
}
handler main::work(n: int) -> (int, error) {
    block_on("gate-1")
    return 0, nil
}
