// facts: act358 starts go Finish after a partial action; Runtime.Handle releases opMu when action returns, so Finish's opMu lock is asynchronous cleanup, not reentry on the Handle goroutine.
// model: go Finish executes independently; Handle can return and release opMu.
runtime main { resource evaluation capacity 1 }
op main::handleAction() -> u64 {
    effect pure
    lock opMu
}
handler main::handleAction() -> (u64, error) {
    return 0, nil
}
op main::asyncFinish() -> u64 {
    effect pure
    lock opMu
}
handler main::asyncFinish() -> (u64, error) {
    return 0, nil
}
