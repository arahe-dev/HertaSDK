runtime main { resource evaluation capacity 1 }
op main::serviceDrain() -> u64 {
    effect idempotent
    calls processQueuedBatch
}
handler main::serviceDrain() -> (u64, error) {
    return 0, nil
}
op main::processQueuedBatch() -> u64 {
    effect idempotent
    detached for shutdown
}
handler main::processQueuedBatch() -> (u64, error) {
    return 0, nil
