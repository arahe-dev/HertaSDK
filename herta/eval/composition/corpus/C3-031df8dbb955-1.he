// facts: controller.go130-137 waits for rootCtx.Done and gives metricsServer.Shutdown a fresh5s context; deliberate graceful shutdown after root cancellation.
runtime main { resource evaluation capacity 1 }
op main::rootShutdown() -> u64 {
    effect idempotent
    calls metricsShutdown
}
handler main::rootShutdown() -> (u64, error) {
    return 0, nil
}
op main::metricsShutdown() -> u64 {
    effect idempotent
    detached for shutdown
    timeout 5s
}
handler main::metricsShutdown() -> (u64, error) {
    return 0, nil
}
