// facts: SafePath.Close22 holds s.mutex and on path==empty invokes Path28, which Lock52s the same mutex; second Close (or concurrent repeated cleanup) cannot return. Mount Setup stores the same pointer and returns its Close callback (mounts.go203-218).
// model: Reachable repeated Close path holds mutex while synchronously calling Path.
runtime main { resource evaluation capacity 1 }
op main::safePathCloseEmpty() -> u64 {
    effect pure
    lock safePathMutex
    calls path
}
handler main::safePathCloseEmpty() -> (u64, error) {
    return 0, nil
}
op main::path() -> u64 {
    effect pure
    lock safePathMutex
}
handler main::path() -> (u64, error) {
    return 0, nil
}
