runtime main { resource db capacity 8 resource network capacity 4 }
op main::charge(svc: servicePtr, user: string, cents: u64) -> Receipt { effect nonidempotent admission wait resources { db units 1, network units 1 } timeout 500ms retry max 3 on { transient } }
handler main::charge(svc: servicePtr, user: string, cents: u64) -> (Receipt, error) {
return svc.chargeHost(ctx, user, cents)
}
op main::reserve(svc: servicePtr, user: string, sku: string) -> Unit { effect idempotent admission wait resources { db units 1, network units 1 } retry max 3 on { transient, uncertain } }
handler main::reserve(svc: servicePtr, user: string, sku: string) -> (Unit, error) {
return Unit{}, svc.reserveHost(ctx, user, sku)
}
op main::checkout(svc: servicePtr, user: string, sku: string, cents: u64) -> Receipt { effect nonidempotent admission wait }
handler main::checkout(svc: servicePtr, user: string, sku: string, cents: u64) -> (Receipt, error) {
return svc.checkoutHost(ctx, user, sku, cents)
}
