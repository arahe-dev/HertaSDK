runtime main {
    resource db capacity 4
}
op main::op1() -> r {
    effect pure
}
handler main::op1() -> (r, error) {
    if bad { fail transient, err }
    return r, nil }
op main::op2() -> r {
    effect pure
}
handler main::op2() -> (r, error) {
    if bad { fail success, err }
    return r, nil
}
op main::op3() -> r {
    effect pure
}
handler main::op3() -> (r, error) {
    if bad { fail 0, err }
    return r, nil
}
