// Probe's opaque wrapper effect and retry, exposed through calls charge.
runtime main { resource db capacity 8 }
op main::checkout() -> u64 { effect idempotent retry max 3 on { uncertain } calls charge }
handler main::checkout() -> (u64, error) { return 0, nil }
op main::charge() -> u64 { effect nonidempotent  }
handler main::charge() -> (u64, error) { return 0, nil }
