runtime main { resource db capacity 8 resource network capacity 4 }
op main::charge(svc: servicePtr, user: string, cents: u64) -> Receipt { effect nonidempotent admission wait resources { db units 1, network units 1 } timeout 500ms retry max 3 on { transient } 
    classify { ErrTimeout => uncertain, ErrUnavailable => transient, _ => permanent }
}
handler main::charge(svc: servicePtr, user: string, cents: u64) -> (Receipt, error) {
return svc.chargeHost(ctx, user, cents)
}
