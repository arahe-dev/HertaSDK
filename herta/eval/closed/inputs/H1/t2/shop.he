runtime main { resource db capacity 8 resource network capacity 4 }
op main::refund(svc: servicePtr, order_id: int64, cents: u64, order_key: string) -> Unit {
    effect nonidempotent
    admission wait
    resources { db units 1, network units 1 }
    serialize key order_key
}
handler main::refund(svc: servicePtr, order_id: int64, cents: u64, order_key: string) -> (Unit, error) {
    _ = order_key
    return Unit{}, svc.b.Refund(ctx, order_id, cents)
}
